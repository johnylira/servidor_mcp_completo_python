# Obrigatória: chave da API OpenAI ou de um endpoint compatível.
OPENAI_API_KEY=coloque_sua_chave_aqui

# Modelo usado na etapa de geração pelo LangChain.
OPENAI_MODEL=gpt-4o-mini

# Modelo usado pelo LlamaIndex para vetorizar os trechos.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcional: URL-base para provedor compatível com a API OpenAI.
# OPENAI_BASE_URL=https://seu-endpoint/v1

# Persistência e parâmetros do índice RAG.
RAG_DATA_DIR=/data
RAG_COLLECTION=mcp_rag
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=80
